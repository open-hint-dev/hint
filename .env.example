# Trusted local shell settings used only by the static-site publish script.
# Copy this file to .env and fill the values. Never commit .env.
SITE_DEPLOY_HOST=
SITE_DEPLOY_USER=
SITE_DEPLOY_PORT=22
SITE_DEPLOY_PATH=

# Optional. Without these, OpenSSH uses its normal identity and known_hosts.
SITE_DEPLOY_IDENTITY_FILE=
SITE_DEPLOY_KNOWN_HOSTS_FILE=

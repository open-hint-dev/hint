{
  "name": "@openhint/cli",
  "version": "2.0.0",
  "description": "Path-scoped research memory for coding agents",
  "type": "module",
  "bin": {
    "hint": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "vitest run",
    "site:check": "node scripts/check-site.mjs",
    "pack": "yarn pack --out hint.tgz"
  },
  "dependencies": {
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "24.10.9",
    "@vitest/coverage-v8": "4.0.17",
    "eslint": "9.28.0",
    "globals": "16.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.53.1",
    "vitest": "4.0.17"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-hint-dev/hint.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

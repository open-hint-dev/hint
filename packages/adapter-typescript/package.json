{
    "name": "@openhint/adapter-typescript",
    "version": "0.0.0",
    "private": true,
    "description": "The TypeScript language adapter for HINT — reports the symbols a file actually declares, so `hint verify` can check a spec against the shape of the code instead of the presence of a name.",
    "type": "module",
    "bin": {
        "hint-adapter-typescript": "./index.js"
    },
    "scripts": {
        "coverage": "make coverage-js",
        "fix": "make fix-js",
        "lint": "make lint-js",
        "publish": "make publish-js",
        "refresh": "make refresh-js",
        "release": "make release-js",
        "test": "make test-js"
    },
    "dependencies": {
        "typescript": "*"
    },
    "devDependencies": {
        "@openhint/preset-eslint": "workspace:*",
        "@openhint/preset-typescript": "workspace:*",
        "eslint": "*",
        "vite": "*"
    }
}
